{
  "name": "nba-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next & next build",
    "start": "next start",
    "lint": "next lint",
    "generate:api-types": "npm run generate:api-types:scores && npm run generate:api-types:stats",
    "generate:api-types:scores": "swagger2openapi https://sportsdata.io/downloads/swagger/nba-v3-scores.json -o ./types/generated/nba-scores-openapi3.json && openapi-typescript ./types/generated/nba-scores-openapi3.json -o ./types/generated/sportsdata-scores.d.ts",
    "generate:api-types:stats": "swagger2openapi https://sportsdata.io/downloads/swagger/nba-v3-stats.json -o ./types/generated/nba-stats-openapi3.json && openapi-typescript ./types/generated/nba-stats-openapi3.json -o ./types/generated/sportsdata-stats.d.ts"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.562.0",
    "next": "^16.1.1",
    "openapi-fetch": "^0.15.0",
    "react": "^19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.3",
    "swiper": "^12.0.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.1",
    "jsdom": "^27.0.1",
    "lightningcss": "^1.30.2",
    "openapi-typescript": "^7.10.1",
    "plop": "^4.0.4",
    "postcss": "^8.5.6",
    "swagger2openapi": "^7.0.8",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
